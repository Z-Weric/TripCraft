# 高德地图 Web API Key
# 申请地址: https://lbs.amap.com/dev/key/app
AMAP_API_KEY=

# 硅基流动 API Key (用于 LLM 调用)
# 申请地址: https://siliconflow.cn
SILICONFLOW_API_KEY=

# LLM 模型名称
LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro

# LLM API 地址（OpenAI 兼容接口）
LLM_API_BASE=https://api.siliconflow.cn/v1/chat/completions

# LLM Provider：ollama / openai_compatible / disabled
# 训练数据生成时用 openai_compatible（外部教师），线上推理可切回 ollama
LLM_DEFAULT_PROVIDER=openai_compatible
LLM_FALLBACK_PROVIDER=ollama
LLM_ENABLED_SCOPES=itinerary,chat

# 本地 Ollama（当前开发机已安装 qwen3.5:9b）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=90
OLLAMA_RETRIES=1
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_QUEUE_TIMEOUT=5
OLLAMA_CIRCUIT_FAILURE_THRESHOLD=3
OLLAMA_CIRCUIT_COOLDOWN=30

# JWT 签名密钥（生产环境必须使用至少 32 字符的随机值）
JWT_SECRET=change-me-in-production

# 训练数据审核员邮箱白名单，多个邮箱用英文逗号分隔；未配置时审核池默认拒绝访问
TRAINING_REVIEWER_EMAILS=

# 自动训练数据评审：完成校准前保持 false；裁判至少配置两个独立 Provider
AUTO_EVAL_ENABLED=false
# 可选值：ollama、openai_compatible、judge_a、judge_b。
# 生成教师模型不能出现在这里；至少配置两个与生成模型不同的裁判。
# 典型配置：裁判A=本地Ollama(qwen3.5:9b)，裁判B=外部GLM-5.1
# 教师用 DeepSeek-V4-Pro，与两个裁判均不同源
AUTO_EVAL_JUDGE_PROVIDERS=ollama,judge_a
# 裁判 A：复用本地 Ollama 配置（无需额外填写）
# 裁判 B：外部独立模型
AUTO_EVAL_JUDGE_A_API_BASE=https://api.siliconflow.cn/v1/chat/completions
AUTO_EVAL_JUDGE_A_API_KEY=
AUTO_EVAL_JUDGE_A_MODEL=Pro/zai-org/GLM-5.1
AUTO_EVAL_JUDGE_B_API_BASE=
AUTO_EVAL_JUDGE_B_API_KEY=
AUTO_EVAL_JUDGE_B_MODEL=
AUTO_EVAL_MAX_CONCURRENCY=2
AUTO_EVAL_TIMEOUT=90
AUTO_EVAL_ACCEPT_CONFIDENCE=0.85
AUTO_EVAL_MIN_CORE_SCORE=3
AUTO_EVAL_ALLOW_UNVERIFIED_CLAIMS=true
AUTO_EVAL_AUTO_APPROVE=false
AUTO_EVAL_AUTO_APPROVE_CONFIDENCE=0.85
AUTO_EVAL_SAMPLE_RATE=0.10
AUTO_EVAL_EVIDENCE_ENABLED=false
AUTO_EVAL_EVIDENCE_MAX_CLAIMS=3
AUTO_EVAL_REPAIR_ENABLED=false
AUTO_EVAL_REPAIR_PROVIDER=openai_compatible
AUTO_EVAL_REPAIR_MAX_ITERATIONS=2
AUTO_EVAL_REPAIR_TRIGGER_ENABLED=false
AUTO_EVAL_REPAIR_TRIGGER_THRESHOLD=40
AUTO_EVAL_REPAIR_TRIGGER_BATCH_SIZE=40

# 博查 Web Search：用于离线裁判对事实包未覆盖声明进行带来源检索
# 仅存储脱敏声明、来源链接、摘要和检索时间，不将密钥提交到版本库
BOCHA_API_KEY=
BOCHA_SEARCH_API_BASE=https://api.bochaai.com/v1/web-search
BOCHA_SEARCH_TIMEOUT=20

# 分享链接有效期（小时，默认 7 天）
SHARE_TOKEN_EXPIRE_HOURS=168

# Docker Compose 本地数据库（宿主机已使用 3306，因此容器映射到 3307）
DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3307/tripcraft?charset=utf8mb4

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 每个行程天数召回的候选 POI 倍数
CANDIDATE_POOL_MULTIPLIER=8

# 高德地图 Web API Key
# 申请地址: https://lbs.amap.com/dev/key/app
AMAP_API_KEY=

# 硅基流动 API Key (用于 LLM 调用)
# 申请地址: https://siliconflow.cn
SILICONFLOW_API_KEY=

# LLM 模型名称
LLM_MODEL=meituan-longcat/LongCat-2.0

# LLM Provider：ollama / openai_compatible / disabled
LLM_DEFAULT_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=openai_compatible
LLM_ENABLED_SCOPES=itinerary,chat

# 本地 Ollama（当前开发机已安装 qwen3.5:9b）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=90
OLLAMA_RETRIES=1
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_QUEUE_TIMEOUT=5
OLLAMA_CIRCUIT_FAILURE_THRESHOLD=3
OLLAMA_CIRCUIT_COOLDOWN=30

# JWT 签名密钥（生产环境必须使用至少 32 字符的随机值）
JWT_SECRET=change-me-in-production

# 分享链接有效期（小时，默认 7 天）
SHARE_TOKEN_EXPIRE_HOURS=168

# Docker Compose 本地数据库（宿主机已使用 3306，因此容器映射到 3307）
DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3307/tripcraft?charset=utf8mb4

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 每个行程天数召回的候选 POI 倍数
CANDIDATE_POOL_MULTIPLIER=8
